# ---- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soc_ai?schema=public"

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# ---- AI providers ---------------------------------------------------------
# Set at least one. AI_PROVIDER picks the default; the app falls back to
# whichever key is present.
AI_PROVIDER="openai"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ---- Meta (Instagram + Facebook) -----------------------------------------
# From https://developers.facebook.com/apps
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v21.0"

# ---- Scheduler ------------------------------------------------------------
# Shared secret for GET /api/cron/publish
CRON_SECRET="replace-me"
